---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---
<Layout title="Support Us" current="support" description="Learn how mentorship, manufacturing access, materials, equipment, and financial support could help establish Nittany Rover Team and Project SUNRISE.">
  <PageIntro title="Support the team" text="Early support can help Nittany Rover Team turn a shared ambition into a sustained engineering effort at Penn State University Park." />
  <section class="container article-section"><p class="eyebrow support-heading">Where support can make a difference</p><div class="mission-grid"><article><span class="index">01</span><h3>Technical mentorship</h3><p>Experience in robotics, systems engineering, scientific methods, or space hardware can help students ask better questions and evaluate their designs.</p></article><article><span class="index">02</span><h3>Manufacturing access</h3><p>Access to fabrication capabilities and practical manufacturing guidance can help bridge the gap between concept and physical prototype.</p></article><article><span class="index">03</span><h3>Materials & equipment</h3><p>Materials, components, instrumentation, and test equipment can support concept evaluation, prototyping, and integration.</p></article><article><span class="index">04</span><h3>Financial support</h3><p>Funding can enable development and competition preparation as the team establishes its requirements and plans.</p></article></div></section>
  <section class="container section split"><h2>Contact the team</h2><div>{site.contactEmail ? <><p>Contact the team to discuss how your experience or resources could support Project SUNRISE.</p><div class="actions"><a class="button" href={`mailto:${site.contactEmail}`}>Contact Nittany Rover Team ↗</a></div></> : <><span class="closed-label">Support inquiries are not yet open</span><p>We’re establishing the team’s contact channel. Verified contact details will appear here when we are ready to receive inquiries.</p></>}</div></section>
</Layout>

<style>
  .support-heading{font-size:1.25rem;font-weight:700;letter-spacing:.04em}
</style>
